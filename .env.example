# Local development defaults for `supabase start`. Never put real credentials here.
# Run `pnpm env:local` to write .env.local with the local Supabase API keys filled in.

# Public Supabase Auth endpoint and publishable key (browser-safe).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key. Used by integration tests to create Auth
# users; never read by the application runtime.
SUPABASE_SECRET_KEY=

# Exact origin used to build auth email redirect links.
APP_ORIGIN=http://127.0.0.1:3000

# Admin connection: migrations, provisioning, bootstrap, recovery only.
ADMIN_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Runtime connection as fintrack_app through the transaction pooler.
# Hosted Supabase uses the form fintrack_app.<project-ref>@<pooler-host>:6543.
DATABASE_URL=postgresql://fintrack_app.pooler-dev:local-fintrack-app-password-0001@127.0.0.1:54329/postgres

# Keepalive probe connection as fintrack_probe (production only in hosted environments).
KEEPALIVE_DATABASE_URL=postgresql://fintrack_probe.pooler-dev:local-fintrack-probe-password-001@127.0.0.1:54329/postgres
KEEPALIVE_TOKEN=local-keepalive-token-change-me-0000000000

# Daily Telegram digest (production only). Keep these in Vercel as Sensitive values;
# REMINDER_TOKEN must equal the GitHub Actions secret FINTRACK_REMINDER_TOKEN.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
REMINDER_TOKEN=

# Role passwords consumed by scripts/provision-roles.mts (minimum 24 characters).
FINTRACK_APP_DB_PASSWORD=local-fintrack-app-password-0001
FINTRACK_PROBE_DB_PASSWORD=local-fintrack-probe-password-001
FINTRACK_BACKUP_DB_PASSWORD=local-fintrack-backup-password-01
